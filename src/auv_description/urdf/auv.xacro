<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="auv">

  <!-- ============================================================
       AUV Description — Real Body (SolidWorks export, URDF_AUV)
       Thrusters are FIXED (visual-only) — no actuation yet.
       Gazebo motion is handled by the SDF plugins in model.sdf.
       ============================================================ -->

  <!-- ── Base Link ─────────────────────────────────────────────── -->
  <link name="base_link">
    <inertial>
      <!-- Design-team CAD inertia (dry, no electronics).
           Gazebo physics uses model.sdf values (74 kg, tuned). -->
      <origin xyz="0.0342192228746154 -1.94199123143583E-05 0.0127520533943641" rpy="0 0 0"/>
      <mass value="11.7363957459801"/>
      <inertia
        ixx="0.0945859213511898"  ixy="-1.27954399069145E-09" ixz="1.21781883017742E-08"
        iyy="0.225604371478563"   iyz="2.26054612723564E-05"
        izz="0.215001008980752"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auv_description/meshes/base_link.STL"/>
      </geometry>
      <material name="auv_grey">
        <color rgba="0.753 0.753 0.753 1"/>
      </material>
    </visual>
    <collision>
      <!-- Bounding box for performance — matches Gazebo SDF collision -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.6 0.4 0.3"/>
      </geometry>
    </collision>
  </link>

  <!-- ── Thruster 1 (front-right lateral) ─────────────────────── -->
  <link name="Thruster_1">
    <inertial>
