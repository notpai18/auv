        izz="3.44436528248629E-06"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://auv_description/meshes/Thruster_1.STL"/>
      </geometry>
      <material name="auv_blue_grey">
        <color rgba="0.792 0.820 0.933 1"/>
