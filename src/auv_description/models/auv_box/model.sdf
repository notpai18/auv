    <!-- ── Thruster 8 (rear-left vertical) ────────────────────────────── -->
    <link name="Thruster_8">
      <pose relative_to="base_link">-0.125 0.3647 0.043352 3.1416 0 0</pose>
      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.334e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.336e-06</iyy><iyz>0</iyz>
          <izz>3.444e-06</izz>
        </inertia>
      </inertial>
      <visual name="Thruster_8_visual">
        <geometry>
