    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>auv_box</namespace>
      <joint_name>T_5</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1025.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>

    <!-- ── Thruster 6 (front-left vertical) ───────────────────────────── -->
    <link name="Thruster_6">
      <pose relative_to="base_link">0.125 0.3647 -0.017952 0 0 0</pose>
      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.334e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.336e-06</iyy><iyz>0</iyz>
          <izz>3.444e-06</izz>
        </inertia>
      </inertial>
      <visual name="Thruster_6_visual">
        <geometry>
          <mesh><uri>package://auv_description/meshes/Thruster_6.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.792 0.820 0.933 1</ambient>
          <diffuse>0.792 0.820 0.933 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="T_6" type="revolute">
      <pose relative_to="Thruster_6">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>Thruster_6</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e12</lower><upper>1e12</upper><effort>-1</effort><velocity>-1</velocity></limit>
