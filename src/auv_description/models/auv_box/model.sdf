      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.334e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.336e-06</iyy><iyz>0</iyz>
          <izz>3.444e-06</izz>
        </inertia>
      </inertial>
      <visual name="Thruster_7_visual">
        <geometry>
          <mesh><uri>package://auv_description/meshes/Thruster_7.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.792 0.820 0.933 1</ambient>
          <diffuse>0.792 0.820 0.933 1</diffuse>
