<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="auv_box">
    
    <link name="base_link">
      <!-- Gravity ON — real physical weight is balanced by the buoyancy_link below. -->
      <gravity>1</gravity>
      <inertial>
        <!-- Design team CAD mass (dry). Inertia computed for equivalent uniform box -->
        <mass>11.7364</mass>
        <inertia>
          <ixx>0.997889</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>1.159488</iyy>
          <iyz>0.0</iyz>
          <izz>1.496176</izz>
        </inertia>
      </inertial>

      <visual name="base_link_visual">
        <!-- Real AUV body mesh from design team (SolidWorks export) -->
        <geometry>
          <mesh>
            <uri>package://auv_description/meshes/base_link.STL</uri>
          </mesh>
        </geometry>
        <material>
          <!-- Silver-grey: matches the design team's colour (rgba ~0.753 0.753 0.753) -->
          <ambient>0.6 0.6 0.6 1</ambient>
          <diffuse>0.75 0.75 0.75 1</diffuse>
          <specular>0.3 0.3 0.3 1</specular>
        </material>
      </visual>

      <collision name="base_link_collision">
        <!-- Box sized to real AUV STL bounding box (0.9206 x 0.8260 x 0.5814 m).
             Pose offset X=0.0494 aligns box centre with mesh centroid. -->
        <pose>0.0494 0 0.0127 0 0 0</pose>
        <geometry>
          <box>
            <size>0.9206 0.8260 0.5814</size>
          </box>
        </geometry>
      </collision>
    </link>

    <!-- Camera 1 - Front Left -->
    <link name="front_left_camera_link">
      <!-- x=0.55: the hull mesh (base_link.STL) tapers to a nose tip whose
           surface still reaches x=0.5097, so anything at x=0.50 sits inside
           the solid geometry — the camera rendered the inside of the hull
           instead of open water. 0.55 clears the tip by ~4cm. -->
      <pose relative_to="base_link">0.55 0.0375 0 0 0 0</pose>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="front_left_camera_visual">
        <pose>0 -0.0375 0 0 0 0</pose>
        <geometry>
          <box>
            <!-- OAK-D Lite dimensions: 17.5mm (depth) x 91mm (width) x 28mm (height) -->
            <size>0.0175 0.091 0.028</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.1 0 0 1</specular>
        </material>
      </visual>
      <sensor name="front_left_camera_sensor" type="camera">
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <topic>/model/auv_box/stereo_front/left/image_raw</topic>
        <camera>
          <!-- WATER VISIBILITY TOGGLE (all three cameras — keep them in sync)

               Uncommented, mask 0x00000001 would hide any world visual whose
               own visibility_flags clear bit 0, letting the pool look filled
               in the GUI while these frames stay pixel-identical to the ones
               YOLO and the HSV thresholds were tuned on. camera_test.sdf does
               not use visibility_flags on its water visuals (see its own
               comment on water_volume for why), so this has no effect today —
               left here in case a future world adopts that scheme. -->
          <!-- <visibility_mask>1</visibility_mask> -->
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>19.1</far>
          </clip>
        </camera>
      </sensor>
    </link>
    
    <joint name="front_left_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_left_camera_link</child>
    </joint>

    <!-- Camera 2 - Front Right -->
    <link name="front_right_camera_link">
      <!-- x=0.55 — see front_left_camera_link above; must match its X exactly
           or stereo disparity breaks. -->
      <pose relative_to="base_link">0.55 -0.0375 0 0 0 0</pose>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <sensor name="front_right_camera_sensor" type="camera">
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <topic>/model/auv_box/stereo_front/right/image_raw</topic>
        <camera>
          <!-- Water visibility toggle — see front_left_camera_sensor above.
               MUST match the left camera exactly or stereo disparity breaks. -->
          <!-- <visibility_mask>1</visibility_mask> -->
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>19.1</far>
          </clip>
        </camera>
      </sensor>
    </link>
    
    <joint name="front_right_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>front_right_camera_link</child>
    </joint>

    <!-- Camera 3 - Bottom -->
    <link name="bottom_camera_link">
      <pose relative_to="base_link">0 0 -0.28 0 1.5708 0</pose>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.0001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0001</iyy><iyz>0</iyz>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
      <visual name="bottom_camera_visual">
        <geometry>
          <box>
            <size>0.0175 0.091 0.028</size>
          </box>
        </geometry>
        <material>
          <ambient>1 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
          <specular>0.1 0 0 1</specular>
        </material>
      </visual>
      <sensor name="bottom_camera_sensor" type="camera">
        <update_rate>10</update_rate>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <topic>/model/auv_box/bottom/image_raw</topic>
        <camera>
          <!-- Water visibility toggle — see front_left_camera_sensor above.
               WATCH THIS ONE FIRST: it looks down at the green target mat and
               the drums from close range, so the HSV green/blue segmentation is
               the most likely thing to need retuning now that the water is
               visible. Being close to the mat, fog affects it least, so a
               narrower HSV hue shift is expected here than on the front pair. -->
          <!-- <visibility_mask>1</visibility_mask> -->
          <horizontal_fov>1.274</horizontal_fov>
          <image>
            <width>640</width>
            <height>480</height>
          </image>
          <clip>
            <near>0.2</near>
            <far>19.1</far>
          </clip>
        </camera>
      </sensor>
    </link>
    
    <joint name="bottom_camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>bottom_camera_link</child>
    </joint>

    <!-- ── Buoyancy Link ─────────────────────────────────────────────── -->
    <!-- Sized for exact neutral buoyancy in salt water (rho = 1025 kg/m^3):
         V = 11.7364 kg / 1025 kg/m^3 = 0.011450146 m^3 (0.225391 m cube).
         Center of Buoyancy at Z=+0.0627 m is +0.05 m above Center of Mass (Z=+0.01275 m),
         providing metacentric restoring stability against roll and pitch.
         collide_bitmask 0 ensures fluid lift without solid obstacle collision. -->
    <link name="buoyancy_link">
      <pose relative_to="base_link">0.0342 0 0.0627 0 0 0</pose>
      <inertial>
        <mass>0.0001</mass>
        <inertia>
          <ixx>0.00001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.00001</iyy><iyz>0</iyz>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <collision name="buoyancy_collision">
        <geometry>
          <box>
            <size>0.225391 0.225391 0.225391</size>
          </box>
        </geometry>
        <surface>
          <contact>
            <collide_bitmask>0</collide_bitmask>
          </contact>
        </surface>
      </collision>
    </link>

    <joint name="buoyancy_joint" type="fixed">
      <parent>base_link</parent>
      <child>buoyancy_link</child>
    </joint>

    <!-- ── Thruster 1 (front-right horizontal, 45 deg) ────────────────── -->
    <link name="Thruster_1">
      <pose relative_to="base_link">0.32408 -0.29242 0.0127 -1.5708 0 -0.7854</pose>
      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.336e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.335e-06</iyy><iyz>0</iyz>
          <izz>3.444e-06</izz>
        </inertia>
      </inertial>
      <visual name="Thruster_1_visual">
        <geometry>
          <mesh><uri>package://auv_description/meshes/Thruster_1.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.792 0.820 0.933 1</ambient>
          <diffuse>0.792 0.820 0.933 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="T_1" type="revolute">
      <pose relative_to="Thruster_1">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>Thruster_1</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e12</lower><upper>1e12</upper><effort>-1</effort><velocity>-1</velocity></limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>auv_box</namespace>
      <joint_name>T_1</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1025.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>

    <!-- ── Thruster 2 (front-left horizontal, 45 deg) ─────────────────── -->
    <link name="Thruster_2">
      <pose relative_to="base_link">0.32408 0.29242 0.0127 -1.5708 0 -2.3562</pose>
      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.336e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.335e-06</iyy><iyz>0</iyz>
          <izz>3.444e-06</izz>
        </inertia>
      </inertial>
      <visual name="Thruster_2_visual">
        <geometry>
          <mesh><uri>package://auv_description/meshes/Thruster_2.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.792 0.820 0.933 1</ambient>
          <diffuse>0.792 0.820 0.933 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="T_2" type="revolute">
      <pose relative_to="Thruster_2">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>Thruster_2</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e12</lower><upper>1e12</upper><effort>-1</effort><velocity>-1</velocity></limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>auv_box</namespace>
      <joint_name>T_2</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1025.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>

    <!-- ── Thruster 3 (rear-left horizontal, 45 deg) ──────────────────── -->
    <link name="Thruster_3">
      <pose relative_to="base_link">-0.36742 -0.24908 0.0127 -1.5708 0 -2.3562</pose>
      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.336e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.335e-06</iyy><iyz>0</iyz>
          <izz>3.444e-06</izz>
        </inertia>
      </inertial>
      <visual name="Thruster_3_visual">
        <geometry>
          <mesh><uri>package://auv_description/meshes/Thruster_3.STL</uri></mesh>
        </geometry>
        <material>
          <ambient>0.792 0.820 0.933 1</ambient>
          <diffuse>0.792 0.820 0.933 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name="T_3" type="revolute">
      <pose relative_to="Thruster_3">0 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>Thruster_3</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><lower>-1e12</lower><upper>1e12</upper><effort>-1</effort><velocity>-1</velocity></limit>
      </axis>
    </joint>
    <plugin filename="gz-sim-thruster-system" name="gz::sim::systems::Thruster">
      <namespace>auv_box</namespace>
      <joint_name>T_3</joint_name>
      <thrust_coefficient>0.02</thrust_coefficient>
      <fluid_density>1025.0</fluid_density>
      <propeller_diameter>0.1</propeller_diameter>
    </plugin>

    <!-- ── Thruster 4 (rear-right horizontal, 45 deg) ─────────────────── -->
    <link name="Thruster_4">
      <pose relative_to="base_link">-0.36742 0.24908 0.0127 -1.5708 0 -0.7854</pose>
      <inertial>
        <mass>0.00833</mass>
        <inertia>
          <ixx>2.336e-06</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>2.335e-06</iyy><iyz>0</iyz>
