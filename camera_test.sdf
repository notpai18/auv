<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="camera_world">

    <scene>
      <ambient>0.3 0.4 0.5 1</ambient>
      <background>0.0 0.25 0.45 1</background>
      <shadows>true</shadows>
    </scene>

    
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.05 0.2 0.25 1</ambient><diffuse>0.05 0.2 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>


    <model name="qual_gate">
      <static>true</static>
      <pose>4 0 0 0 0 0</pose>
      <link name="left_pole">
        <pose>0 1.5 1 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
      <link name="right_pole">
        <pose>0 -1.5 1 0 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>2</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
      <link name="crossbar">
        <pose>0 0 2 1.5708 0 0</pose>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>3</length></cylinder></geometry>
          <material><ambient>1 0.5 0 1</ambient><diffuse>1 0.5 0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
